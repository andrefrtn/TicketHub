# No npm run dev, a demonstração é ativada por padrão.
# Use 0 para criar uma instalação com contas próprias.
# TICKETHUB_DEMO=0
#
# Primeiro administrador. Configure antes da primeira execução sem demonstração.
# TICKETHUB_ADMIN_EMAIL=admin@sua-empresa.com
# TICKETHUB_ADMIN_PASSWORD=
#
# Caminho opcional em um volume persistente.
# TICKETHUB_DB=.data/tickethub.sqlite
#
# Triagem por IA (somente no servidor).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
#
# Integração com um provedor de e-mail. Use um segredo aleatório com 32+ caracteres.
# TICKETHUB_MAIL_SECRET=
# TICKETHUB_BASE_URL=https://suporte.sua-empresa.com
